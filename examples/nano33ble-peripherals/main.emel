import Embedded.Board.{BoardGpio, BoardUart, BoardSpi, BoardI2c}
import Embedded.Gpio
import Embedded.Interrupt.{Normal}
import Embedded.Uart
import Embedded.Spi
import Embedded.I2c

# Native nRF pins: P0.n = n, P1.n = 32 + n. The green LED is active-low.
fn edge(event: Gpio.GpioEvent) -> () {
  with BoardGpio {
    (use Gpio.Gpio).toggle(Gpio.GpioPin(16))
  } escape { Gpio.GpioError(_) -> () }
}

pub fn main() -> Int {
  with BoardGpio {
    with BoardUart {
      with BoardSpi {
        with BoardI2c {
          gpio = use Gpio.Gpio
          gpio.configure(Gpio.GpioPin(16), Gpio.OutputPushPull(Gpio.NoPull, Gpio.High))
          gpio.configure(Gpio.GpioPin(43), Gpio.Input(Gpio.Up))
          gpio.enable_interrupt(Gpio.GpioPin(43), Gpio.Falling, Normal, edge)
          uart = use Uart.Uart
          uart.configure(Uart.Uart0, Uart.UartConfig(115200, Uart.Bits8, Uart.One,
            Uart.NoParity, Uart.Both, Uart.NoFlowControl, Uart.Native))
          (use Spi.Spi).create_device(Spi.SpiDeviceConfig(Spi.Spi1,
            Spi.SpiConfig(Spi.Master, Spi.TwoLine, Spi.Bits8, Spi.IdleLow,
              Spi.FirstEdge, 1000000, Spi.MostSignificantFirst),
            Gpio.GpioPin(34), Gpio.Low, 0, 0))
          (use I2c.I2c).configure(I2c.I2c1, I2c.I2cConfig(100000, I2c.Standard))
          uart.transmit(Uart.Uart0, [82, 69, 65, 68, 89, 10], 20)
          0
        }
      }
    }
  } escape {
    Gpio.GpioError(_) -> 1
    Uart.UartError(_) -> 2
    Spi.SpiTransactionError(_, _) -> 3
    I2c.I2cError(_) -> 4
  }
}
