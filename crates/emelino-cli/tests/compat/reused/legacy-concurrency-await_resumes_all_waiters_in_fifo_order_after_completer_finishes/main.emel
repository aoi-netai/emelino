
import Std.Fiber.{Fiber, Scope}
import Std.Deferred.{Deferred}
@external(c, "mark")
fn mark(n: Int) -> () uses {}
pub fn work() -> Int uses { Async } {
  Fiber.scope(|| {
    d: Deferred[Int] = (use Scope).deferred()
    a: Deferred[()] = (use Scope).deferred()
    b: Deferred[()] = (use Scope).deferred()
    Fiber.fork(|| {
      x = Deferred.await(d)
      mark(x + 1)
      Deferred.complete(a, ())
    })
    Fiber.fork(|| {
      x = Deferred.await(d)
      mark(x + 2)
      Deferred.complete(b, ())
    })
    Fiber.fork(|| {
      mark(30)
      Deferred.complete(d, 10)
      mark(31)
    })
    mark(0)
    Deferred.await(a)
    Deferred.await(b)
    mark(40)
    Deferred.await(d)
  })
}
