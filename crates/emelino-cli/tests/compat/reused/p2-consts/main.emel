@external(c, "board_seed")
fn seed(n: Int) -> Int use {}
@external(c, "board_zero")
fn zero() -> Int use {}
const FIRST = seed(1)
const SECOND = FIRST + seed(2)
const UNUSED = seed(3)
const BROKEN = 1 / zero()
pub fn read_first() -> Int { FIRST }
pub fn read_second() -> Int { SECOND }
pub fn read_broken() -> Int { BROKEN }
