@external(c, "board_integer")
fn board_integer(n: Int64) -> Int64 use {}
@external(c, "board_mix")
fn board_mix(n: Int64, x: Float) -> Float use {}
fn integer_helper(n: Int64) -> Int64 { board_integer(n) }
pub fn integer_bits(n: Int64) -> Int64 { integer_helper(n) }
pub fn float_bits(n: Int64, x: Float) -> Float { board_mix(n, x) }
