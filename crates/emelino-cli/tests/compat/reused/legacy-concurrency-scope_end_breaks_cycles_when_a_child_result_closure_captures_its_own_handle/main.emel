
import Std.Fiber.{Fiber, Scope}
import Std.Deferred.{Deferred}
pub fn cycle() -> Bool uses { Async } {
  Fiber.scope(|| {
    d: Deferred[Fiber[fn() -> Bool uses { Async }]] = (use Scope).deferred()
    child = Fiber.fork(|| {
      me = Deferred.await(d)
      || { Fiber.join(me)
        True }
    })
    Deferred.complete(d, child)
    callback = Fiber.join(child)
    callback()
  })
}
