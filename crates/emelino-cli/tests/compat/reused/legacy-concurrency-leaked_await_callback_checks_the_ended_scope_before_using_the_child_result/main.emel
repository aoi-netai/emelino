import Std.Exit.{Success, Failure}

import Std.Fiber.{Fiber}
pub fn leak() -> (fn() -> Int uses { Async }) uses { Async } {
  Fiber.scope(|| {
    child = Fiber.fork(|| 42)
    Fiber.join(child)
    || Fiber.await(child) match { Success(v) -> v
      Failure(_) -> -1 }
  })
}
pub fn invoke(f: fn() -> Int fails {} uses { Async }) -> Int uses { Async } { f() }
