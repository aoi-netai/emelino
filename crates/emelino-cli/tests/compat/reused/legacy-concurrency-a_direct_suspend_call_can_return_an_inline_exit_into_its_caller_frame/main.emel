import Std.Exit.{Exit, Success, Failure}

import Std.Fiber.{Fiber}
fn terminal(child: Fiber[Int]) -> Exit[Int, {}] uses { Async } { Fiber.await(child) }
pub fn work(n: Int) -> Int uses { Async } {
  Fiber.scope(|| {
    child = Fiber.fork(|| n)
    terminal(child) match { Success(v) -> v
      Failure(_) -> -1 }
  })
}
