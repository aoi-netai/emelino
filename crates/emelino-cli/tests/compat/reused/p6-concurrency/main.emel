import Std.Exit

import Std.Fiber
import Std.Deferred
import Std.Cause
pub fn answer()->Int{Fiber.scope(|| {child=Fiber.fork(|| 42)
Fiber.join(child)})}
pub fn attempt()->Int{Exit.attempt(|| 42) match{Exit.Success(value)->value
Exit.Failure(cause)->0}}
pub fn unit()->Int{Fiber.scope(|| {child=Fiber.fork(|| ())
Fiber.join(child)
42})}
pub fn deferred()->Int{Fiber.scope(|| {d=Fiber.deferred()
Fiber.fork(|| Deferred.complete(d,42))
Deferred.await(d)})}
pub fn deferred_unit()->Int {Fiber.scope(|| {d=Fiber.deferred()
first=Deferred.complete(d,())
second=Deferred.complete(d,())
Deferred.await(d)
if first && !second {Deferred.poll(d) match {Some(())->42
None->0}}else{0}
})}
error Oops(message:String) derive Show
fn raise()->Int fails Oops {fail Oops(message:String.append("x","!"))}
pub fn cause()->Bool {Exit.attempt(raise) match {
Exit.Success(value)->False
Exit.Failure(cause)->Cause.kind(cause)==Cause.Fail && Cause.to_string(cause)=="error: Oops(message: \"x!\")"
}}
pub fn recover()->Int {{Exit.attempt(raise) match {
Exit.Success(value)->value
Exit.Failure(cause)->Cause.raise(cause)
}} escape {Oops(message:)->42}}
