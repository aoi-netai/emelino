
import Std.Fiber.{Fiber}
@external(c, "mark")
fn mark(n: Int) -> () uses {}
pub fn work(n: Int) -> Int uses { Async } {
  Fiber.scope(|| {
    child = Fiber.fork(|| { mark(2)
      n + 1 })
    mark(1)
    first = Fiber.join(child)
    mark(3)
    Fiber.fork(|| mark(99))
    second = Fiber.join(child)
    mark(4)
    first + second
  })
}
pub fn unit() -> () uses { Async } {
  Fiber.scope(|| {
    child = Fiber.fork(|| mark(1))
    Fiber.join(child)
    Fiber.join(child)
    mark(2)
  })
}
