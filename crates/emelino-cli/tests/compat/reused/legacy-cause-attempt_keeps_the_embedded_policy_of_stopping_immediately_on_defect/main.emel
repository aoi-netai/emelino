import Std.Exit.{Success, Failure}

import Std.Fiber.{Fiber}
@external(c, "mark")
fn mark(n: Int) -> () uses {}
effect Resource { fn read() -> Int }
handler Res: Resource { fn read() { 0 }
 release { mark(99) }
}
pub fn stopped() -> Int {
 Exit.attempt(|| with Res { panic("test defect") }) match {
  Success(_) -> 1
  Failure(_) -> 2
 }
}
