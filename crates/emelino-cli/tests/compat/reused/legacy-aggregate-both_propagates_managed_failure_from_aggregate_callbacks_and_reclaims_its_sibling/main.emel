import Std.Fiber.{Fiber, Exit}
@external(c, "host_wait")
suspend fn wait(n: Int) -> Int
effect Wait { suspend fn get(n: Int) -> Int }
handler Waiting: Wait { suspend fn get(n, resume) { resume(wait(n)) } }

pub enum Packet { Data((String, Option[String]), List[String])
  Empty }
fn packet(n: Int) -> Packet {
  text = Int.to_string(n)
  Data((text, Some(text)), [text])
}
pub fn both(n: Int) -> ((String, Option[String]), Option[String]) use Async {
  with Waiting {
    text = Int.to_string(n)
    Fiber.both(fn() {
      (use Wait).get(10)
      (text, Some(text))
    }, fn() {
      (use Wait).get(20)
      Some(Int.to_string(n + 1))
    })
  }
}
pub fn terminal(n: Int, cancel: Bool) -> Exit[Packet, {}] use Async {
  with Waiting {
    Fiber.scope(fn() {
      child = Fiber.fork(fn() {
        (use Wait).get(30)
        packet(n)
      })
      (use Wait).get(40)
      if cancel { Fiber.interrupt(child) }
      Fiber.await(child)
    })
  }
}
effect Echo { suspend fn echo(value: Packet) -> Packet }
handler Echoing: Echo {
  suspend fn echo(value, resume) {
    wait(50)
    resume(value)
  }
}
pub fn echoed(n: Int) -> Packet use Async {
  with Waiting {
    with Echoing {
      value = (use Echo).echo(packet(n))
      (use Wait).get(60)
      value
    }
  }
}
error Missing(text: String)
fn right(n: Int, bad: Bool) -> Packet fails Missing use Wait {
  (use Wait).get(20)
  if bad { fail Missing(Int.to_string(n)) }
  packet(n + 1)
}
pub fn checked(n: Int, bad: Bool) -> String use Async {
  with Waiting {
    result = Fiber.both(fn() { (use Wait).get(10)
      packet(n) }, fn() { right(n, bad) }) escape {
      Missing(text) -> (Empty, Data((text, None), []))
    }
    (_, value) = result
    value match {
      Data(pair, _) -> { (text, note) = pair
        note match { Some(suffix) -> String.append(text, suffix)
          None -> text } }
      Empty -> "missing"
    }
  }
}
