
import Std.Fiber.{Fiber, Scope}
import Std.Deferred.{Deferred}
pub fn leak() -> (fn() -> Int uses { Async }) uses { Async } {
  Fiber.scope(|| {
    d: Deferred[Int] = (use Scope).deferred()
    || Deferred.await(d)
  })
}
pub fn invoke(f: fn() -> Int fails {} uses { Async }) -> Int uses { Async } { f() }
