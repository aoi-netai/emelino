
import Std.Fiber.{Fiber}
pub fn wide(n: Int64) -> Int64 uses { Async } {
  Fiber.scope(|| { child = Fiber.fork(|| n)
    Fiber.join(child) })
}
pub fn real(n: Float) -> Float uses { Async } {
  Fiber.scope(|| { child = Fiber.fork(|| n)
    Fiber.join(child) })
}
pub fn flag(n: Bool) -> Bool uses { Async } {
  Fiber.scope(|| { child = Fiber.fork(|| n)
    Fiber.join(child) })
}
