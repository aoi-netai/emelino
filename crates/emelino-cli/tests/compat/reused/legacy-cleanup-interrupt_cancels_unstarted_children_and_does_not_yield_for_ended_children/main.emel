
import Std.Fiber.{Fiber}
@external(c, "mark")
fn mark(n: Int) -> () uses {}
pub fn work() -> Int uses { Async } {
  Fiber.scope(|| {
    skipped = Fiber.fork(|| mark(99))
    Fiber.interrupt(skipped)
    Fiber.interrupt(skipped)
    done = Fiber.fork(|| 42)
    value = Fiber.join(done)
    Fiber.fork(|| mark(99))
    Fiber.interrupt(done)
    mark(1)
    value
  })
}
