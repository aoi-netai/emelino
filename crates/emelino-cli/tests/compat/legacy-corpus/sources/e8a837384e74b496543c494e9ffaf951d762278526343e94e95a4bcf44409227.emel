
@external(c, "fixture_zero")
fn raw_zero() -> Int
effect Zero { fn read() -> Int }
handler BoardZero: Zero { fn read() { raw_zero() } }
fn zero() -> Int { with BoardZero { (use Zero).read() } }
const B = 1 / zero()
const A = { dbg("A")
 B }
const SELF = if zero() == 0 { SELF } else { 42 }
pub fn bad() -> Int { A }
pub fn self_ref() -> Int { SELF }
