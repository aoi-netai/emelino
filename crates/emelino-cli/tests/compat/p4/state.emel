import Std.State.{State}
import Std.Bytes.{Bytes}

@external(c, "mark")
fn mark(value: Int) -> Int use {}
@external(c, "mutate_input")
fn mutate_input() -> () use {}

fn escaped(initial: Int) -> fn() -> Int {
  (reader, _) = State.run(initial, fn() {
    state = use State[Int]
    fn() {
      state.update(fn(value) { value + 1 })
      state.get()
    }
  })
  reader
}

@export(c, "state_counter")
pub fn counter() -> Int {
  reader = escaped(40)
  (value, _) = State.run(0, fn() { reader() + reader() })
  value
}

@export(c, "state_owned")
pub fn owned(text: String, expected: String) -> Bool {
  ((saved, reader), final) = State.run(text, fn() {
    state = use State[String]
    saved = state.get()
    state.update(fn(value) { String.append(value, "!") })
    (saved, fn() { state.get() })
  })
  mutate_input()
  (result, _) = State.run("", fn() {
    saved == expected && final == String.append(expected, "!") && reader() == final
  })
  result
}

error StateFailure(value: String)
@export(c, "state_failure")
pub fn failure(text: String) -> Bool {
  value = State.run(text, fn() {
    state = use State[String]
    state.set(String.append(state.get(), "!"))
    fail StateFailure(state.get())
    0
  }) escape { StateFailure(value) -> (42, value) }
  value == (42, String.append(text, "!"))
}

fn callback(marker: Int) -> fn() -> Int use State[Int] {
  mark(marker + 2)
  fn() {
    state = use State[Int]
    state.update(fn(value) { value + 40 })
    state.get()
  }
}
@export(c, "state_order")
pub fn order() -> Int {
  (value, final) = State.run(body: callback(mark(1)), initial: mark(2))
  assert value == final
  value
}

@export(c, "state_nested")
pub fn nested() -> Int use {} {
  (result, final) = State.run(1, fn() {
    (text, _) = State.run("x", fn() {
      (use State[Int]).update(fn(value) { value + 40 })
      (use State[String]).update(fn(value) { String.append(value, "!") })
      (use State[String]).get()
    })
    assert text == "x!"
    (use State[Int]).get() + 1
  })
  assert result == 42 && final == 41
  runner = State.run
  assert runner(0, fn() {
    (use State[Int]).set(42)
    42
  }) == (42, 42)
  result
}

@export(c, "state_bytes")
pub fn bytes(text: String) -> Bool {
  ((saved, read), final) = State.run(Bytes.encode_utf8(text), fn() {
    state = use State[Bytes]
    saved = state.get()
    state.update(fn(value) { Bytes.append(value, Bytes.encode_utf8("!")) })
    (saved, fn() { state.get() })
  })
  mutate_input()
  (result, _) = State.run(Bytes.encode_utf8(""), fn() {
    Bytes.to_list(saved) == [97, 0, 98] && Bytes.to_list(final) == [97, 0, 98, 33] && read() == final
  })
  result
}

@export(c, "captured_bytes")
pub fn captured_bytes(text: String) -> Bytes {
  value = Bytes.encode_utf8(text)
  read = fn() { value }
  read()
}

@export(c, "shared_bytes")
pub fn shared_bytes(input: Bytes) -> Bytes {
  (value, _) = State.run(input, fn() {
    state = use State[Bytes]
    state.set(Bytes.append(state.get(), state.get()))
    state.get()
  })
  value
}
