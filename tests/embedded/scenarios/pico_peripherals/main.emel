import Embedded.Board.{BoardGpio, BoardUart, BoardSpi, BoardI2c}
import Embedded.Gpio
import Embedded.Uart
import Embedded.Spi
import Embedded.I2c
import Embedded.Interrupt.{Normal}
@external(c, "pico_check")
fn raw_check(number: Int, success: Int) -> () uses {}
@external(c, "pico_wait")
fn wait_stage(stage: Int) -> () uses {}
@external(c, "pico_finish")
fn finish() -> () uses {}
@external(c, "pico_callback")
fn callback() -> () uses {}
@external(c, "pico_callback_count")
fn callback_count() -> Int uses {}
fn on_pin(event: Gpio.GpioEvent) -> () { callback() }
fn check(number: Int, success: Bool) -> () { raw_check(number, if success { 1 } else { 0 }) }
fn is_high(state: Gpio.PinState) -> Bool { state match {
 Gpio.High -> True
 Gpio.Low -> False
} }
fn spi_config(bits: Spi.SpiDataSize) -> Spi.SpiConfig {
  Spi.SpiConfig(Spi.Master, Spi.TwoLine, bits, Spi.IdleLow,
    Spi.FirstEdge, 1000000, Spi.MostSignificantFirst)
}
pub fn main() -> () {
  with BoardGpio { with BoardUart { with BoardSpi { with BoardI2c {
        gpio = use Gpio.Gpio
        gpio.configure(Gpio.GpioPin(25), Gpio.OutputPushPull(Gpio.NoPull, Gpio.Low))
        gpio.write(Gpio.GpioPin(25), Gpio.High)
        gpio.toggle(Gpio.GpioPin(25))
        gpio.write(Gpio.GpioPin(25), Gpio.High)
        gpio.configure(Gpio.GpioPin(2), Gpio.Input(Gpio.NoPull))
        check(1, is_high(gpio.read(Gpio.GpioPin(2))))
        gpio.configure(Gpio.GpioPin(3), Gpio.Input(Gpio.Down))
        gpio.enable_interrupt(Gpio.GpioPin(3), Gpio.Rising, Normal, on_pin)
        wait_stage(1)
        check(2, callback_count() == 1)
        gpio.disable_interrupt(Gpio.GpioPin(3))
        check(3, {
          gpio.configure(Gpio.GpioPin(23), Gpio.Input(Gpio.NoPull))
          False
        } escape { Gpio.GpioError(Gpio.InvalidArgument) -> True
          Gpio.GpioError(_) -> False })
        uart = use Uart.Uart
        uart.configure(Uart.Uart0, Uart.UartConfig(115200, Uart.Bits8, Uart.One,
          Uart.NoParity, Uart.Both, Uart.NoFlowControl, Uart.Native))
        uart.transmit(Uart.Uart0, [80, 73, 67, 79, 10], 20)
        wait_stage(2)
        check(10, uart.receive(Uart.Uart0, 1, 20) == [65])
        uart.enable_interrupt(Uart.Uart0, Normal, True)
        uart.set_receive_mode(Uart.Uart0, Uart.InterruptReceive)
        wait_stage(3)
        check(11, uart.receive_some(Uart.Uart0, 4, 20) == [67])
        uart.transmit(Uart.Uart0, [73, 82, 81, 10], 20)
        check(12, {
          uart.receive(Uart.Uart0, 1, 1)
          False
        } escape { Uart.UartError(Uart.Timeout) -> True
          Uart.UartError(_) -> False })
        uart.disable_interrupt(Uart.Uart0)
        uart.set_receive_mode(Uart.Uart0, Uart.Polling)
        check(13, {
          uart.configure(Uart.Uart1, Uart.UartConfig(115200, Uart.Bits8, Uart.One,
            Uart.NoParity, Uart.Both, Uart.NoFlowControl, Uart.Native))
          False
        } escape { Uart.UartError(Uart.Unsupported) -> True
          Uart.UartError(_) -> False })
        spi = use Spi.Spi
        spi.configure(Spi.Spi1, spi_config(Spi.Bits8))
        check(20, spi.transfer(Spi.Spi1, [18, 52], 20) == [18, 52])
        device = spi.create_device(Spi.SpiDeviceConfig(Spi.Spi1, spi_config(Spi.Bits8),
          Gpio.GpioPin(17), Gpio.Low, 1, 1))
        check(21, spi.transaction(device, [Spi.Transfer([86, 120])], 20) == [[86, 120]])
        spi.configure(Spi.Spi1, spi_config(Spi.Bits16))
        check(22, spi.transfer(Spi.Spi1, [4660], 20) == [4660])
        spi.recover(Spi.Spi1)
        check(23, {
          spi.configure(Spi.Spi2, spi_config(Spi.Bits8))
          False
        } escape { Spi.SpiError(Spi.Unsupported) -> True
          Spi.SpiError(_) -> False })
        i2c = use I2c.I2c
        i2c.configure(I2c.I2c1, I2c.I2cConfig(100000, I2c.Standard))
        check(30, i2c.write_read(I2c.I2c1, 80, [208], 1, 20) == [85])
        i2c.memory_write(I2c.I2c1, 80, 32, I2c.Bits8, [68, 85], 20)
        check(31, i2c.write_read(I2c.I2c1, 80, [32], 2, 20) == [68, 85])
        i2c.master_transmit(I2c.I2c1, 80, [32], 20)
        check(32, i2c.write_read(I2c.I2c1, 80, [], 2, 20) == [68, 85])
        check(33, {
          i2c.is_device_ready(I2c.I2c1, 80, 1, 20)
          False
        } escape { I2c.I2cError(I2c.Unsupported) -> True
          I2c.I2cError(_) -> False })
        i2c.enable_interrupt(I2c.I2c1, Normal)
        check(34, i2c.write_read(I2c.I2c1, 80, [208], 1, 20) == [85])
        i2c.disable_interrupt(I2c.I2c1)
        check(35, {
          i2c.master_transmit(I2c.I2c1, 81, [1], 20)
          False
        } escape { I2c.I2cError(I2c.Nack) -> True
          I2c.I2cError(_) -> False })
        i2c.recover(I2c.I2c1, 20)
        check(36, i2c.write_read(I2c.I2c1, 80, [208], 1, 20) == [85])
  } } } } escape {
    Gpio.GpioError(_) -> raw_check(96, 0)
    Uart.UartError(Uart.Overrun) -> raw_check(9701, 0)
    Uart.UartError(_) -> raw_check(97, 0)
    Spi.SpiError(_) -> raw_check(98, 0)
    Spi.SpiTransactionError(_, _) -> raw_check(99, 0)
    I2c.I2cError(I2c.Timeout) -> raw_check(10001, 0)
    I2c.I2cError(_) -> raw_check(100, 0)
  }
  finish()
}
