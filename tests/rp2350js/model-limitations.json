  "limitations": {
    "uart_error_status": {
      "source": "src/peripherals/uart.ts:RPUART.readUint32",
      "reason": "UARTRSR (offset 0x04) is absent from the read switch; fallback returns 0xffffffff even after write-clear. Real UART sticky receive error status is therefore unreadable."
    },
    "i2c_disable_status": {
      "source": "src/peripherals/i2c.ts:RPI2C.readUint32",
      "reason": "IC_ENABLE_STATUS (offset 0x9c) is declared but absent from the read switch; fallback returns 0xffffffff after ENABLE=0. Correct bounded controller-disable waits time out before START."
    },
    "gpio_output": {
      "source": "src/cortex-m33/coprocessor.ts:cp0Gpioc",
      "reason": "SDK 2.3.1 gpio_put/gpio_set_dir emit MCRR p0 #4; the CP0 handler only handles MCR/MRC and also interprets opc1 as bank instead of operation. SDK GPIO output operations do not reach SIO."
    },
    "gpio_irq": {
      "source": "src/peripherals/io_rp2350.ts:RP2350IO.readUint32/writeUint32",
      "reason": "Register grouping uses (offset % 0x18) * 0x18. For PROC0_INTE0 0x248 this yields 0xc0, so it cannot select the 0x248 case; GPIO enable/status registers never update/read correctly."
    }
  },
